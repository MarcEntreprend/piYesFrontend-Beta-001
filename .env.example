# ===========================================
# Frontend (Vite)
# ===========================================

# URL du backend Express
# En dev : proxy Vite (redirige /api vers localhost:3000)
VITE_API_URL=http://localhost:5173

# Alternative (appel direct backend distant) :
# VITE_API_URL=https://your-backend.vercel.app

# Supabase (clé publique anon)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# AI keys
VITE_GEMINI_API_KEY=your_gemini_api_key
VITE_DEEPSEEK_API_KEY=your_deepseek_api_key


# ===========================================
# Backend
# ===========================================

# DATABASE_URL=
# DIRECT_URL=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
NODE_ENV=development
GEMINI_API_KEY=your_gemini_api_key

# MonCash Configuration
MONCASH_CLIENT_ID=your_moncash_client_id
MONCASH_CLIENT_SECRET=your_moncash_client_secret
MONCASH_BUSINESS_KEY=your_moncash_business_key
MONCASH_API_HOST=sandbox.moncashbutton.digicelgroup.com/Api
MONCASH_GATEWAY_URL=https://sandbox.moncashbutton.digicelgroup.com/Moncash-middleware
MONCASH_RETURN_URL=https://your-return-url.com/callback
MONCASH_ALERT_URL=https://your-alert-url.com